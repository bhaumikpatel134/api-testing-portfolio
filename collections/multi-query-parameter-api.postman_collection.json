    {
      "name": "Name and Username",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const users = pm.response.json();\r",
              "\r",
              "pm.test(\"Response is not empty\", function () {\r",
              "    pm.expect(users.length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Correct name returned\", function () {\r",
              "    pm.expect(users[0].name).to.eql(\"Leanne Graham\");\r",
              "});\r",
              "\r",
              "pm.test(\"Correct username returned\", function () {\r",
              "    pm.expect(users[0].username).to.eql(\"Bret\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
