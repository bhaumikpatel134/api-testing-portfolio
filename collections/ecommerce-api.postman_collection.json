    {
      "name": "Sorting",
      "item": [
        {
          "name": "Get: Sort Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Products are sorted by title alphabetically\", function () {",
                  "    const products = pm.response.json().products;",
                  "",
                  "    for (let i = 0; i < products.length - 1; i++) {",
                  "        const currentTitle = products[i].title.toLowerCase();",
                  "        const nextTitle = products[i + 1].title.toLowerCase();",
                  "        ",
                  "        // Directly asserts that the current title is less than or equal to the next",
                  "        pm.expect(currentTitle <= nextTitle).to.be.true;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products?sortBy=title&order=asc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "title"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          },
          "response": []
        }
