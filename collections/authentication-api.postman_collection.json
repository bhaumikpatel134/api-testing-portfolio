          "name": "Valid Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Access token exists\", function () {\r",
                  "    pm.expect(json.accessToken).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Refresh token exists\", function () {\r",
                  "    pm.expect(json.refreshToken).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"accessToken\",\r",
                  "    json.accessToken\r",
                  ");\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"refreshToken\",\r",
                  "    json.refreshToken\r",
                  ");"
                ],
